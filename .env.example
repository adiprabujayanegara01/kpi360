# Salin menjadi .env lalu sesuaikan. JANGAN commit .env.
SECRET_KEY=ganti-dengan-string-acak-panjang
# SQLite (default, untuk development) atau PostgreSQL (produksi)
# DATABASE_URL=postgresql+psycopg2://kpi360:kpi360@localhost:5432/kpi360
SESSION_COOKIE_SECURE=0          # set 1 bila memakai HTTPS
REGISTRATION_ENABLED=0

# ---- AI ----
# none      : insight berbasis aturan (tanpa LLM, tanpa biaya)
# anthropic : Claude API (isi ANTHROPIC_API_KEY)
# openai    : API kompatibel OpenAI, termasuk LLM lokal (Ollama/LM Studio/vLLM)
LLM_PROVIDER=none
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
LLM_ANONYMIZE=1                  # kirim ID pengganti, bukan nama, ke LLM
LLM_TIMEOUT=40

# ---- Email (opsional) ----
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=kpi360@example.com
